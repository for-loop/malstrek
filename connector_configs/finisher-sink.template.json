{
  "name": "malstrek-finisher-sink",
  "config": {
    "value.converter.schema.registry.url": "${KAFKA_SCHEMA_REGISTRY_URL}",
    "name": "malstrek-finisher-sink",
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "errors.tolerance": "all",
    "topics": "finish-line",
    "errors.deadletterqueue.topic.name": "finish-line-dlq",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "connection.url": "jdbc:postgresql://${TIMESCALEDB_HOST}:${TIMESCALEDB_PORT}/${TIMESCALEDB_DB}",
    "connection.user": "${TIMESCALEDB_USER}",
    "connection.password": "${TIMESCALEDB_PASSWORD}",
    "dialect.name": "PostgreSqlDatabaseDialect",
    "transforms": "ConvertTimestamp",
    "transforms.ConvertTimestamp.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.ConvertTimestamp.field": "timestamp",
    "transforms.ConvertTimestamp.target.type": "Timestamp",
    "transforms.ConvertTimestamp.unix.precision": "milliseconds",
    "insert.mode": "insert",
    "table.name.format": "finishers",
    "pk.mode": "none",
    "pk.fields": "",
    "auto.create": "true"
  }
}
