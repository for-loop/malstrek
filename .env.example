# ============================================================================
# Kafka Configuration
# ============================================================================
# REQUIRED - Kafka broker address (from streamer infrastructure)
# For local development, use 0.0.0.0:9092
KAFKA_BOOTSTRAP_SERVERS=broker:29092

# REQUIRED - Schema Registry URL (from streamer infrastructure)
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# REQUIRED - Kafka Connect URL (from streamer infrastructure)
# Used for automatic connector setup
KAFKA_CONNECT_URL=http://connect:8083

# ============================================================================
# TimescaleDB / PostgreSQL Configuration
# ============================================================================
# REQUIRED - Database host (should match streamer/malstrek networking)
TIMESCALEDB_HOST=malstrek-db

# REQUIRED - Database name for malstrek application
TIMESCALEDB_DB=malstrek

# REQUIRED - Database user (should match POSTGRES_USER below)
TIMESCALEDB_USER=malstrek

# REQUIRED - Database password (should match POSTGRES_PASSWORD below)
TIMESCALEDB_PASSWORD=changeme

# Database port (internal)
TIMESCALEDB_PORT=5432

# Local port to expose PostgreSQL for development tools
TIMESCALEDB_LOCAL_PORT=5432

# ============================================================================
# Metabase Configuration
# ============================================================================
# These values are used by both Metabase and the metabase-db PostgreSQL container

# Database type for Metabase backend
MB_DB_TYPE=postgres

# Database host for Metabase
MB_DB_HOST=metabase-db

# Metabase database name
MB_DB_DBNAME=metabase

# Metabase database port
MB_DB_PORT=5432

# Metabase database user (should match POSTGRES_USER below)
MB_DB_USER=metabase

# Metabase database password (should match POSTGRES_PASSWORD below)
MB_DB_PASS=changeme

# ============================================================================
# PostgreSQL Container Configuration
# ============================================================================
# These are used by both metabase-db and to configure the database

# PostgreSQL default user (used for both metabase-db and malstrek-db)
POSTGRES_USER=postgres

# PostgreSQL default database
POSTGRES_DB=postgres

# PostgreSQL password
POSTGRES_PASSWORD=changeme

